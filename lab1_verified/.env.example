LLM_BASE_URL=https://api.deepseek.com
LLM_AUTH_TOKEN=PASTE_YOUR_KEY_HERE
LLM_MODEL=deepseek-flash
LLM_TIMEOUT=90
# Shared ceiling for all labs, upper peak-rate estimate; ledger survives restarts.
LLM_BUDGET_USD=5
LLM_MAX_CALLS=3000

# Reproducible reference date; CSV contains marked training data.
MACRO_ASOF=2026-04-22
MACRO_DATA_MODE=snapshot
